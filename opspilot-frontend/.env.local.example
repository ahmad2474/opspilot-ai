# Where the FastAPI backend is reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Auth (Section 3.5) -------------------------------------------------
# NextAuth's own config. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value

# Single admin-style login (email/password, no OAuth, single account scope).
# ADMIN_PASSWORD_HASH is a bcrypt hash of your password, base64-encoded --
# never a plaintext password, and never a raw (un-encoded) bcrypt hash.
# Generate it in one step with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(h => console.log(Buffer.from(h).toString('base64')))" "your-password-here"
# WHY base64: a raw bcrypt hash contains literal `$` characters
# (`$2b$10$...`), and Next.js's .env loader treats `$` as
# variable-expansion syntax -- pasting the hash directly silently
# truncates it to nothing. Base64-encoding it first sidesteps that
# entirely (lib/auth.ts decodes it before use); don't paste a raw hash
# here even if you remember to escape the `$` characters by hand.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-base64-of-your-bcrypt-hash

# Shared secret used to sign/verify the short-lived API bearer token that
# lets FastAPI independently validate the session (see opspilot-backend
# app/core/security.py). MUST match AUTH_SHARED_SECRET in opspilot-backend/.env.
AUTH_SHARED_SECRET=replace-with-another-long-random-value
